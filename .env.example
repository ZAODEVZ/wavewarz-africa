# The WaveWarZ backend this frontend reads. Server-side only (never sent to the browser).
# Must serve GET /api/public/battles?limit=&offset= and GET /api/public/stats in the
# wavewarz.info shape. Unset, the public wavewarz.info is used so the site runs on day one.
WW_API_BASE=https://wavewarz.info

# What the site calls itself and the region it fronts.
WW_SITE_NAME=WaveWarZ Africa
WW_REGION=Africa

# Where a battle's "open on WaveWarZ" button goes when the API gives no url for it.
WW_BATTLE_URL_BASE=https://wavewarz.com/battle/

# Seconds a page keeps API answers before reading again (ISR).
WW_REVALIDATE=60
